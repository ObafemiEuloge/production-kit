# Copier en .env.production et renseigner. Ne jamais versionner le fichier rempli.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=
REDIS_PASSWORD=
NODE_ENV=production
# Sauvegardes
BACKUP_DIR=/var/backups/postgres
KEEP_DAYS=14
S3_BUCKET=
# Supervision
HEALTHCHECK_URL=https://example.com/health
ALERT_WEBHOOK=
